{
  "manifest_version": 3,
  "name": "Сводка комментариев YouTube",
  "version": "0.18.4",
  "description": "ИИ-сводка комментариев YouTube, поиск по всем плейлистам, очередь вместо сотен вкладок, клипы из видео и удобные режимы плеера.",
  "permissions": [
    "storage",
    "sidePanel",
    "downloads",
    "tabs",
    "contextMenus",
    "scripting",
    "declarativeNetRequestWithHostAccess",
    "alarms"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://i.ytimg.com/*",
    "http://localhost:8080/*",
    "https://*.onrender.com/*",
    "https://sponsor.ajay.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "early.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "early-main.js",
        "clip-main.js",
        "playlists-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "transcript.js",
        "thumb-preview.js",
        "content.js",
        "clip.js",
        "playlists.js",
        "queue.js",
        "video-actions.js",
        "select.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "sponsor.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.youtube.com/embed/*"
      ],
      "js": [
        "early.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.youtube.com/embed/*"
      ],
      "js": [
        "transcript.js",
        "content.js",
        "sponsor.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Сводка комментариев YouTube",
    "default_icon": {
      "16": "icons/icon16.png",
      "20": "icons/icon20.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "20": "icons/icon20.png",
    "24": "icons/icon24.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "Открыть панель «Сводка комментариев»"
    },
    "toggle-no-autoplay": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Вкл/выкл: не запускать видео автоматически"
    },
    "toggle-hide-progress": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Вкл/выкл: скрыть полосу прогресса и длительность"
    },
    "save-to-playlists": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Сохранить видео в плейлисты (поиск и несколько сразу)"
    },
    "save-to-last-playlist": {
      "description": "Сохранить видео в последний плейлист (куда сохраняли последним)"
    },
    "toggle-queue-mode": {
      "description": "Вкл/выкл «Режим очереди» на ленте: нажатые видео улетают в очередь"
    },
    "open-library": {
      "description": "Открыть «Мою библиотеку» — поиск по всем плейлистам"
    },
    "collect-tabs": {
      "description": "Собрать все вкладки с видео YouTube в очередь"
    },
    "defer-video": {
      "description": "Отложить это видео в очередь (и закрыть вкладку)"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
