{
  "manifest_version": 3,
  "name": "РЎРІРѕРґРєР° РєРѕРјРјРµРЅС‚Р°СЂРёРµРІ YouTube",
  "version": "0.2.6",
  "description": "AI-СЃРІРѕРґРєР° РѕР±СЃСѓР¶РґРµРЅРёСЏ, С‚РµРјС‹ Рё СѓРјРЅС‹Р№ РїРѕРёСЃРє РїРѕ РєРѕРјРјРµРЅС‚Р°СЂРёСЏРј YouTube. РџСЂРµРІСЊСЋ РІРёРґРµРѕ РІ РѕС‚РґРµР»СЊРЅРѕР№ РІРєР»Р°РґРєРµ Рё РёРЅС„Рѕ Рѕ РєР°РЅР°Р»Рµ.",
  "permissions": [
    "storage",
    "sidePanel",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://i.ytimg.com/*",
    "http://localhost:8080/*",
    "https://*.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "РЎРІРѕРґРєР° РєРѕРјРјРµРЅС‚Р°СЂРёРµРІ YouTube",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
